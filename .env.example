# ── Frontend deployment env ───────────────────────────────────────────────────
# VITE_* values are browser-visible. Never put Worker, Cloudflare, exchange,
# backend operator or service-role secrets in them.
#
# Local development:
#   VITE_BACKEND_URL=http://127.0.0.1:8787
#   VITE_DEMO_MODE=true
#
# Canonical Vercel production:
#   VITE_BACKEND_URL=https://crypto-signal-bot-api.analyzer-d94.workers.dev
#   VITE_DEMO_MODE=false
#   VITE_SUPABASE_URL=<identity-provider project URL>
#   VITE_SUPABASE_PUBLISHABLE_KEY=<publishable/anon browser key>
#
# The canonical crypto-signal-bot-indol.vercel.app runtime ignores a true demo
# flag and never injects the synthetic demo identity.

VITE_BACKEND_URL=http://127.0.0.1:8787
VITE_WS_URL=
VITE_CRYPTOCORE_API_BASE=http://127.0.0.1:8787
VITE_DEMO_MODE=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Current execution / data hierarchy ───────────────────────────────────────
# Primary execution exchange: BTCC
# Secondary execution exchange: Bitget
# Public market-data source: Coinbase
#
# These names describe routing authority only. The current release is locked to
# paper/certification/testnet and performs no real exchange mutation.
EXECUTION_EXCHANGE_PRIMARY=btcc
EXECUTION_EXCHANGE_SECONDARY=bitget
MARKET_DATA_PUBLIC_EXCHANGE=coinbase

# ── Worker-only production configuration ─────────────────────────────────────
# Set these as Cloudflare Worker variables/secrets, not VITE_* values.
# SUPABASE_URL=<same identity-provider project URL>
# SUPABASE_PUBLISHABLE_KEY=<publishable/anon key used only to validate bearer sessions>
# BACKEND_API_KEY=<server operator secret; never expose to browsers>
#
# Permanent certification locks:
TRADING_MODE=paper
EXCHANGE_MODE=paper
NETWORK=testnet
ALLOW_MAINNET=false
LIVE_TRADING_ENABLED=false
WITHDRAWALS_ENABLED=false

# ── Legacy Python backend local database ─────────────────────────────────────
DATABASE_URL=sqlite:///./crypto_bot.db
