# Full-stack deployment environment — copy to .env and adjust as needed.
# Docker Compose automatically reads .env from the repo root.

# ── Trading mode ──────────────────────────────────────────────────────────────
# Production and certification are paper-only.
TRADING_MODE=paper
# binance | bitget | btcc
EXCHANGE=binance
# false = synthetic paper pricing, true = paper execution with selected live public market data
PAPER_USE_LIVE_MARKET_DATA=false
# Defaults to EXCHANGE when left aligned with the same venue.
MARKET_DATA_PUBLIC_EXCHANGE=binance
# testnet | mainnet
NETWORK=testnet

# ── Authentication ────────────────────────────────────────────────────────────
# Required for every privileged write, agent-memory, and D1-query route.
# Missing values fail closed, including in local development.
BACKEND_API_KEY=replace-with-a-long-random-local-secret

# ── Exchange credentials (live mode only) ─────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BTCC_API_KEY=
BTCC_API_SECRET=
# Mainnet remains disabled in this release.
ALLOW_MAINNET=false

# ── Frontend routing ──────────────────────────────────────────────────────────
VITE_BACKEND_URL=/api
VITE_API_BASE_URL=/api

# ── Optional Supabase frontend auth / edge functions ─────────────────────────
# Leave empty for local paper-mode without Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=120

# ── Guardian thresholds ───────────────────────────────────────────────────────
GUARDIAN_MAX_API_ERRORS=10
GUARDIAN_MAX_FAILED_ORDERS=5
GUARDIAN_MAX_DRAWDOWN_PCT=0.05
