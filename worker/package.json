{
  "name": "crypto-signal-bot-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.toml",
    "dev:local": "wrangler dev --config ../wrangler.toml --local",
    "build": "tsc",
    "build:live-candidate": "tsc --project tsconfig.json",
    "build:provider-contracts": "tsc --project tsconfig.providers.json",
    "bundle:live-candidate": "wrangler deploy --dry-run --config ../wrangler.live-candidate.toml --outdir .wrangler/live-candidate",
    "bundle:withdrawals-candidate": "wrangler deploy --dry-run --config ../wrangler.withdrawals-candidate.toml --outdir .wrangler/withdrawals-candidate",
    "test:live-foundation": "node --experimental-strip-types --test tests/live-*.test.ts",
    "test:provider-contracts": "node --experimental-strip-types --test tests/live-default-exchanges.test.ts tests/live-bitget-read-only-client.test.ts tests/live-bitget-preview.test.ts tests/live-bitget-execution-candidate.test.ts tests/live-bitget-user-stream.test.ts tests/live-bitget-recovery.test.ts tests/live-btcc-recovery.test.ts",
    "verify:paper-safety": "node scripts/verify-paper-safety.mjs",
    "verify:live-candidate-safety": "node scripts/verify-live-candidate-safety.mjs && node scripts/verify-candidate-command-lock.mjs && node scripts/verify-bitget-execution-candidate-safety.mjs && node scripts/verify-candidate-evidence-persistence.mjs && node scripts/verify-candidate-projection-observability.mjs && node scripts/verify-fill-accounting-safety.mjs && node scripts/verify-reservation-settlement-safety.mjs && node scripts/verify-exchange-recovery-safety.mjs && node scripts/verify-recovery-ingestion-safety.mjs && node scripts/verify-recovery-accounting-approval-safety.mjs",
    "verify:regulated-foundation-safety": "node scripts/verify-regulated-foundation-safety.mjs",
    "verify:certification-safety": "node scripts/verify-certification-safety.mjs",
    "verify:cryptoops-readonly-openapi": "node scripts/verify-cryptoops-readonly-openapi.mjs",
    "deploy": "wrangler deploy --config ../wrangler.toml",
    "cf:whoami": "wrangler whoami --config ../wrangler.toml",
    "migrate": "wrangler d1 execute crypto-signal-bot-db --config ../wrangler.toml --file=migrations/001_init.sql",
    "migrate:local": "wrangler d1 execute crypto-signal-bot-db --config ../wrangler.toml --local --file=migrations/001_init.sql",
    "migrate:remote": "wrangler d1 execute crypto-signal-bot-db --config ../wrangler.toml --remote --file=migrations/001_init.sql",
    "migrate:002": "wrangler d1 execute crypto-signal-bot-db --config ../wrangler.toml --remote --file=migrations/002_hardened.sql",
    "migrate:002:local": "wrangler d1 execute crypto-signal-bot-db --config ../wrangler.toml --local --file=migrations/002_hardened.sql",
    "migrate:003:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/003_live_release_authorizations.sql",
    "migrate:004:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/004_live_idempotency_records.sql",
    "migrate:005:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/005_live_ledger_and_reservations.sql",
    "migrate:006:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/006_live_immutable_audit.sql",
    "migrate:007:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/007_live_exchange_projections.sql",
    "migrate:008:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/008_live_guardian_hierarchy.sql",
    "migrate:009:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/009_live_queue_delivery.sql",
    "migrate:010:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/010_live_authorization.sql",
    "migrate:011:local": "wrangler d1 execute crypto-signal-bot-withdrawals-candidate-db --config ../wrangler.withdrawals-candidate.toml --local --file=migrations/011_live_transfer_lifecycle.sql",
    "migrate:012:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/012_live_observability.sql",
    "migrate:013:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/013_live_certification.sql",
    "migrate:014:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/014_live_candidate_assessment_evidence.sql",
    "migrate:015:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/015_live_fill_accounting.sql",
    "migrate:016:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/016_live_reservation_settlement.sql",
    "migrate:017:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/017_live_recovery_ingestion.sql",
    "migrate:018:approval:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/018_live_recovery_accounting_approval.sql",
    "migrate:018:dispatch:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/018_live_recovery_accounting_dispatch.sql",
    "migrate:018:local": "npm run migrate:018:approval:local && npm run migrate:018:dispatch:local",
    "migrate:019:local": "wrangler d1 execute crypto-signal-bot-live-candidate-db --config ../wrangler.live-candidate.toml --local --file=migrations/019_live_recovery_accounting_approval_validity.sql",
    "smoke": "node scripts/smoke-check.mjs"
  },
  "dependencies": {
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260609.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.86.0"
  }
}
